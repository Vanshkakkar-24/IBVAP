MODEL_PATH=models/face_detection_yunet.onnx
CONFIDENCE_THRESHOLD=0.65
NMS_THRESHOLD=0.30
MIN_FACE_WIDTH=30
MIN_FACE_HEIGHT=30

PROCESS_FPS=10
CAMERA_INDEX=0
RTSP_URL=
CAMERA_ID=CAM_01

BLUR_THRESHOLD=100
BRIGHTNESS_MIN=50
BRIGHTNESS_MAX=210
SIZE_SCORE_REFERENCE_AREA=14400
QUALITY_SIZE_WEIGHT=0.40
QUALITY_BLUR_WEIGHT=0.35
QUALITY_BRIGHTNESS_WEIGHT=0.25

ENABLE_TRACKING=true
ENABLE_VISUALIZATION=true
SAVE_ANNOTATED_OUTPUT=true
DETECTOR_BACKEND=opencv
EXECUTION_PROVIDER=cpu

UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_UPLOAD_MB=500
ALLOWED_CORS_ORIGINS=
RTSP_RECONNECT_SECONDS=5
 
# Database & Cache
DATABASE_URL=sqlite:///data/ibvap.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ibvap
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 / S3 Object Storage (Leave empty for local fallback)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ibvap-snapshots
R2_PUBLIC_URL=
R2_ENDPOINT_URL=
SNAPSHOTS_DIR=outputs/snapshots

# MediaMTX Streaming Server
MEDIAMTX_RTSP_BASE_URL=rtsp://localhost:8554
MEDIAMTX_WEBRTC_BASE_URL=http://localhost:8889

# BoT-SORT Multi-Object Tracking
BOT_SORT_HIGH_THRESH=0.45
BOT_SORT_LOW_THRESH=0.15
BOT_SORT_MATCH_THRESH=0.70
BOT_SORT_TRACK_BUFFER=60
MIN_REID_OBSERVATIONS=3

# Face Snapshot Capture (Strictly No Face Recognition)
FACE_SNAPSHOT_COOLDOWN=5.0
FACE_MIN_CONFIDENCE=0.65
FACE_MIN_SIZE=30
FACE_MIN_SHARPNESS=80.0

# Camera Topology (JSON mapping of adjacency and min/max transition seconds)
# CAMERA_TOPOLOGY_JSON={"CAM-001":{"CAM-002":{"min_seconds":5,"max_seconds":60}}}
